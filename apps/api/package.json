{
	"name": "api",
	"private": true,
	"version": "0.1.0",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"dev": "bun run dev:api & bun run dev:worker & wait",
		"dev:api": "bun --env-file=../../.env --watch src/index.ts",
		"dev:worker": "bun --env-file=../../.env --watch src/jobs/worker.ts",
		"start": "bun --env-file=../../.env src/index.ts",
		"start:worker": "bun --env-file=../../.env src/jobs/worker.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@anthers/db": "workspace:*",
		"@anthers/shared": "workspace:*",
		"@aws-sdk/client-s3": "3.1005.0",
		"@aws-sdk/s3-request-presigner": "3.1005.0",
		"@hono/zod-validator": "^0.5.0",
		"decimal.js": "10.6.0",
		"hono": "^4.7.0",
		"jose": "6.2.1",
		"pg-boss": "12.24.1",
		"resend": "6.9.4",
		"sanitize-html": "2.17.4",
		"sharp": "0.34.5",
		"stripe": "22.3.2",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/sanitize-html": "2.16.1",
		"typescript": "^5.8.0"
	}
}
