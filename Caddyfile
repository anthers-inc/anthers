:80 {
	handle /health {
		respond "OK" 200
	}
	handle {
		redir https://bluebell.parkerhdavis.com{uri} permanent
	}
}

bluebell.parkerhdavis.com {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	@backend path /api/* /admin /admin/* /health/* /static/* /media/*
	handle @backend {
		reverse_proxy {
			to bluebell-backend-blue:8000
			to bluebell-backend-green:8000

			health_uri /health/
			health_interval 15s
			health_timeout 10s
			health_status 2xx
			fail_duration 60s
			max_fails 5
			unhealthy_status 5xx
			lb_policy first
		}
	}

	handle {
		reverse_proxy {
			to bluebell-frontend-blue:3000
			to bluebell-frontend-green:3001

			health_uri /
			health_interval 15s
			health_timeout 10s
			health_status 2xx
			fail_duration 60s
			max_fails 5
			unhealthy_status 5xx
			lb_policy first
		}
	}
}
