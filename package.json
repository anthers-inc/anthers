{
  "name": "anthers",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:api": "bun run --filter api dev",
    "dev:worker": "bun run --filter api dev:worker",
    "dev:web": "bun run --filter web dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check --write .",
    "format": "bunx biome format --write .",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun run packages/db/src/migrate.ts",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "db:seed": "bun run packages/db/src/seed.ts",
    "db:seed:reset": "bun run packages/db/src/seed.ts --reset"
  },
  "devDependencies": {
    "@libsql/client": "0.17.3",
    "drizzle-kit": "0.31.9"
  },
  "dependencies": {
    "croner": "9.0.0",
    "drizzle-orm": "0.45.1"
  }
}
