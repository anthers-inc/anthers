# ─── Anthers — local dev configuration ───
# cp .env.example .env, then fill in the blanks below.
#
# THIS FILE IS DEV-ONLY. Nothing here reaches production: `.env` is gitignored and
# excluded from the Docker build context, and App Platform injects its own values.
#
# It holds only what dev actually needs:
#   • the handful of settings that genuinely differ from production, and
#   • secrets, which must be YOUR OWN dev values — never production's.
#
# Everything else that dev and prod share is read straight from the committed
# `.do/app.yaml` at boot (PORT, STRIPE_PRICE_SEED, STRIPE_PUBLISHABLE_KEY and the
# DMCA_AGENT_* set). Don't copy those here — see apps/api/src/dev-spec-env.ts.
#
# ⚠️ Six of the secrets below are currently the SAME values production uses, which
# means a leaked `.env` is a production compromise. Replace them with dev-only
# credentials as you go; the prod values live in Bitwarden and stay there.


# ══════════════════════════════════════════════════════════════════════════════
#  Differs from production
# ══════════════════════════════════════════════════════════════════════════════

# The containerized Postgres from compose.yaml. `make dev` starts and migrates it.
DATABASE_URL=postgres://anthers:anthers@localhost:5432/anthers

# local = the filesystem under ./content. s3 = Cloudflare R2 (what prod runs).
# On `local` no other STORAGE_* var is read at all, which is why none are listed
# here. To point dev at real R2, add the full set from .do/app.yaml plus a key
# pair — and note STORAGE_REGION must be `auto`, not a region name.
STORAGE_BACKEND=local

# Where the API sends users for links in email, and the CORS origin it allows.
FRONTEND_URL=http://localhost:3000

# Session-cookie domain. Empty = host-only, correct when the SPA and API share an
# origin, as they do locally. Prod sets `.anthers.org` so www works.
COOKIE_DOMAIN=


# ══════════════════════════════════════════════════════════════════════════════
#  Secrets — use dev-only values
# ══════════════════════════════════════════════════════════════════════════════

# The pre-launch gate on the whole site. Pick anything; it's yours.
# ⚠️ Empty does NOT disable the gate — it seals it (nothing matches), so you'd be
# locked out. Bun's .env parser also expands `$` inside single quotes, so avoid
# `$` or escape each one as `\$`.
SITE_PASSWORD=

# Invite keys that skip the gate via anthers.org/?invite=<key>, comma-separated.
# One per person or audience, so a single link can be revoked by dropping it.
SITE_ACCESS_KEYS=

# Stripe test-mode keys: dashboard → Developers → API keys (use a sandbox account).
STRIPE_SECRET_KEY=
# Printed by `stripe listen` when you run `make stripe-webhooks`. Changes each run
# unless you pass --api-key; re-copy it if webhook verification starts failing.
STRIPE_WEBHOOK_SECRET=

# resend.com → API keys. A key on an unverified domain can only send to the
# address that owns the Resend account.
RESEND_API_KEY=
# Optional. Defaults to `Anthers <noreply@anthers.org>`; override if your dev
# Resend key can't send from a verified anthers.org address.
EMAIL_FROM=


# ══════════════════════════════════════════════════════════════════════════════
#  Dev-only — no production counterpart
# ══════════════════════════════════════════════════════════════════════════════

# `make dev` ensures a local account from these, so a wiped dev DB never costs you
# your login. Blank USERNAME/EMAIL/PASSWORD disables it entirely.
# USERNAME is the match key, so changing EMAIL moves the address on your existing
# account rather than creating a second one. PASSWORD is never rewritten on an
# account that already exists — a mismatch is reported, not applied.
DEV_ACCOUNT_USERNAME=
DEV_ACCOUNT_EMAIL=
DEV_ACCOUNT_PASSWORD=
DEV_ACCOUNT_CREATOR=true
# true also grants /admin, which is the moderation queue. For an account this
# file doesn't manage, or one in prod: `bun run db:admin <username>`.
DEV_ACCOUNT_ADMIN=false

# A test-mode acct_… to link to the gauntlet's fixture creator, so its purchase
# rung can complete a real test-mode checkout. Unset = that rung is skipped,
# which is how CI runs it. Needed again after any DB rebuild.
GAUNTLET_STRIPE_ACCOUNT=


# ══════════════════════════════════════════════════════════════════════════════
#  Desktop Studio — only on the Mac that builds installers
# ══════════════════════════════════════════════════════════════════════════════
# Linux and Windows builds need none of this. Unsigned macOS builds work locally
# but Gatekeeper refuses to open them.

# Keychain → "Developer ID Application: Name (TEAMID)"
export APPLE_SIGNING_IDENTITY=
export APPLE_ID=
# An APP-SPECIFIC password from appleid.apple.com, not your Apple ID password.
export APPLE_PASSWORD=
# 10-character team id from developer.apple.com → Membership.
export APPLE_TEAM_ID=
