# ─── Anthers Environment Configuration ───
# Copy to .env and fill in values: cp .env.example .env

# ─── Database (SQLite) ───
# App data
DATABASE_URL=./data/anthers.sqlite
# Job queue (separate file so claim transactions don't share a lock domain
# with app writes — see apps/api/src/jobs/queue.ts)
QUEUE_DATABASE_URL=./data/anthers-queue.sqlite

# ─── API ───
PORT=8000
FRONTEND_URL=http://localhost:3000

# ─── Auth ───
SESSION_SECRET=change-me-to-a-random-secret

# ─── Site Gate ───
# Pre-launch password gate. Leave empty to disable.
SITE_PASSWORD=

# ─── Storage ───
# Options: local, s3 (s3 = DigitalOcean Spaces or any S3-compatible provider)
STORAGE_BACKEND=local
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=nyc3

# ─── Stripe ───
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=

# ─── Stripe Subscription Price IDs ───
STRIPE_PRICE_ROOT=
STRIPE_PRICE_SPROUT=
STRIPE_PRICE_PETAL=
STRIPE_PRICE_BLOOM=

# ─── Resend (Email) ───
RESEND_API_KEY=

# ─── ATProto / Bluesky ───
ATPROTO_CLIENT_ID=
ATPROTO_REDIRECT_URI=
