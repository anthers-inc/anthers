# ─── Anthers Environment Configuration ───
# Copy to .env and fill in values: cp .env.example .env

# ─── Database ───
DATABASE_URL=postgres://postgres:postgres@localhost:5432/anthers
POSTGRES_PASSWORD=postgres

# ─── API ───
PORT=8000
FRONTEND_URL=http://localhost:3000

# ─── Auth ───
SESSION_SECRET=change-me-to-a-random-secret

# ─── Site Gate ───
# Pre-launch password gate. Leave empty to disable.
SITE_PASSWORD=

# ─── Storage ───
# Options: local, s3
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# ─── Stripe ───
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=

# ─── Stripe Subscription Price IDs ───
STRIPE_PRICE_ROOT=
STRIPE_PRICE_SPROUT=
STRIPE_PRICE_PETAL=
STRIPE_PRICE_BLOOM=

# ─── ATProto / Bluesky ───
ATPROTO_CLIENT_ID=
ATPROTO_REDIRECT_URI=
