# ─── Anthers Environment Configuration ───
# Copy to .env and fill in dev values: cp .env.example .env
#
# This file is the CATALOG of every env var (committed, placeholders only —
# never real secrets). Values are handled per environment:
#   • Local dev → your gitignored `.env` (the defaults below are dev-ready).
#   • Production → NOT this file. Non-secrets live in `.do/app.yaml` (committed);
#     secret VALUES are set once in the DO dashboard (encrypted, persist across
#     deploys). You never upload `.env` to prod. See the deployment runbook.
#
# Inline [tags] describe how each var is handled IN PRODUCTION:
#   [spec]    non-secret — value lives in `.do/app.yaml`, deploys on push
#   [bind]    value comes from an App Platform binding in `.do/app.yaml`
#   [secret]  set the VALUE in the DO dashboard (never commit it)
#   [later]   not wired into the prod spec yet — add when that feature ships
#
# The ═══ banners group vars by WHERE they live in the DO deployment. Rule of
# thumb: shared config → app-level; genuinely single-component values → that
# component. Never declare the same key in two places — the empty copy shadows
# the real one (that's what once broke the gate).


# ══════════════════════════════════════════════════════════════════════════════
#  APP-LEVEL   — inherited by every backend component (api · worker · migrate)
# ══════════════════════════════════════════════════════════════════════════════

# The simple default: shared config lives here, and for a small app so do
# api-only RUN_TIME secrets (fine — RUN_TIME scope keeps them out of the web
# bundle; scope a secret to the api component instead only if you want strict
# least-privilege).

# ─── Database (Postgres) ───
# Dev uses the local containerized Postgres (compose.yaml, `make db-up`);
# prod uses DO Managed Postgres. The pg-boss queue shares this DB (pgboss schema).
DATABASE_URL=postgres://anthers:anthers@localhost:5432/anthers	# [bind] prod: ${anthers-db.DATABASE_URL}

# ─── Site Gate ───
# Pre-launch password gate. Leave empty to disable the gate entirely.
SITE_PASSWORD=  						# [secret]
# Invite keys for share links that skip the gate: anthers.org/?invite=<key>
# Comma-separated, one per person or audience so a single link can be revoked
# (drop it from the list) without rotating SITE_PASSWORD on everyone else.
# Redeeming a link sets the same access flag as typing the password.
SITE_ACCESS_KEYS=  						# [secret]  e.g. press-preview,jane-doe

# ─── Storage ───  (api serves/uploads + worker writes transcode output — both use it)
# Options: local, s3 (s3 = DigitalOcean Spaces or any S3-compatible provider).
STORAGE_BACKEND=local  					# [spec]  (dev = local filesystem; prod = s3 → DO Spaces)
SPACES_KEY=            					# [secret]  (prod: DO Spaces access key)
SPACES_SECRET=         					# [secret]
SPACES_BUCKET=anthers-media 			# [spec]
SPACES_REGION=nyc3     					# [spec]

# ─── Stripe (server) ───  (api charges + webhooks — payments are [later])
STRIPE_SECRET_KEY=                   	# [secret] [later]
STRIPE_WEBHOOK_SECRET=               	# [secret] [later]

# ─── Stripe Anthers-Seed Price ID ───  (one recurring $3/mo price; subscription
# quantity = the user's Anthers-Seed count. Must be a price_… id, NOT a prod_… id.)
STRIPE_PRICE_SEED=						# [spec] [later]

# ─── Resend (Email) ───
RESEND_API_KEY=  						# [secret]
# From address for transactional email (welcome/verify). Use a Resend-verified
# domain in prod (e.g. Anthers <noreply@anthers.org>) for deliverability; the
# shared onboarding@resend.dev sender is fine for local/testing.
EMAIL_FROM=Anthers <noreply@anthers.org>	# [spec]  (must be on a Resend-verified domain; onboarding@resend.dev only delivers to the account owner)


# ══════════════════════════════════════════════════════════════════════════════
#  API COMPONENT   — only the api web service reads these
# ══════════════════════════════════════════════════════════════════════════════

PORT=8000                           	# [spec]
FRONTEND_URL=http://localhost:3000  	# [spec] prod: ${APP_URL}


# ══════════════════════════════════════════════════════════════════════════════
#  WEB COMPONENT (static site)   — BUILD-TIME, baked into the browser bundle
# ══════════════════════════════════════════════════════════════════════════════
# Only client-safe, NON-secret values go here (they ship to browsers), at
# BUILD_TIME scope. Stripe's *publishable* key is the client-side counterpart to
# the *secret* key above. Not wired yet (needs build.ts to inject it at build).

STRIPE_PUBLISHABLE_KEY=  				# [spec] [later]  (web build-time; publishable = non-secret)


# ══════════════════════════════════════════════════════════════════════════════
#  DEV-ONLY   — never deployed; only your local `make dev` reads these
# ══════════════════════════════════════════════════════════════════════════════
# Dev bootstrap account. On `make dev`, packages/db/src/ensure-dev-account.ts
# creates a local account with these credentials IF it doesn't already exist
# (create-if-missing, idempotent). Set them to the SAME username/email/password
# you use on prod so a wiped dev DB never costs you your usual login. Leave any
# blank to disable (silent no-op). These stay in your gitignored `.env` only —
# they are NOT part of the DO spec and never ship to prod.
DEV_ACCOUNT_USERNAME=  					# [dev-only] your prod username
DEV_ACCOUNT_EMAIL=     					# [dev-only] your prod email
DEV_ACCOUNT_PASSWORD=  					# [dev-only] your prod password (dev DB only)
DEV_ACCOUNT_CREATOR=true				# [dev-only] false → plain consumer account
# Grant the ops console (/admin) to the bootstrap account. Only affects a
# freshly-created dev account; promote an existing one with `bun run db:admin
# <username>` (that CLI also works against prod via DATABASE_URL).
DEV_ACCOUNT_ADMIN=false					# [dev-only] true → bootstrap account is a platform admin

# ─── DESKTOP STUDIO — macOS code signing & notarization ───
# Only needed on the Mac that builds the desktop installers (`make desktop-build-macos`
# and `make desktop-notarize`). Linux and Windows builds need none of this. Unsigned
# macOS builds are possible but Gatekeeper will refuse to open them, so they're only
# useful for local testing.
#
# APPLE_PASSWORD is an APP-SPECIFIC password from appleid.apple.com, never your real
# Apple ID password. The Makefile deliberately unsets APPLE_ID/PASSWORD/TEAM_ID while
# the bundler runs so Tauri doesn't notarize a binary that is about to be re-signed —
# notarization is the separate `make desktop-notarize` step.
export APPLE_SIGNING_IDENTITY=			# [desktop] "Developer ID Application: Name (TEAMID)"
export APPLE_ID=						# [desktop] Apple developer account email
export APPLE_PASSWORD=					# [desktop] app-specific password, NOT the account password
export APPLE_TEAM_ID=					# [desktop] 10-char team id
