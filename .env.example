# ─── Bluebell Environment Configuration ───
# Copy to .env and fill in values: cp .env.example .env

# ─── Django ───
DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,bluebell.dev
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Database ───
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=bluebell
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
DJANGO_DB_USER=bluebell_app
DJANGO_DB_PASSWORD=change-me-app-password
DEV_DB_USER=parker
DEV_DB_PASSWORD=change-me-dev-password

# ─── Backend ───
BACKEND_PORT=8000

# ─── Frontend ───
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# ─── Storage ───
# Options: local, s3
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# ─── Celery / Redis ───
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─── Stripe ───
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=

# ─── Stripe Subscription Price IDs ───
# Create Products+Prices in Stripe Dashboard, paste the price_xxx IDs here
STRIPE_PRICE_BASE=
STRIPE_PRICE_SUPPORTER=
STRIPE_PRICE_ADVOCATE=
STRIPE_PRICE_CHAMPION=

# ─── ATProto / Bluesky ───
# For production, set these to your public URLs
# Leave blank for dev (auto-detected from request)
FRONTEND_URL=http://localhost:3000
ATPROTO_CLIENT_ID=
ATPROTO_REDIRECT_URI=
