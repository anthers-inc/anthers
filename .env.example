# ─── Anthers — local dev configuration ───
# cp .env.example .env, then fill in the three required DEV_ACCOUNT_ lines
# (USERNAME, EMAIL, PASSWORD). That's it — the other two have defaults.
#
# THIS FILE IS DEV-ONLY. `.env` is gitignored and excluded from the Docker build
# context, and App Platform injects its own values, so nothing here reaches prod.
#
# It is short because almost nothing needs to be here:
#   • Secrets come from the "Anthers Dev" Bitwarden project — `make dev` injects
#     them and they never touch disk. The project itself is the list of which
#     five they are. You only need them in `.env` for `make dev-local`, the
#     offline path, and then they must be dev values, never production's.
#   • Non-secret config that dev shares with prod is read from the committed
#     `.do/app.yaml` at boot (see apps/api/src/dev-spec-env.ts).
#   • Everything else already has a working dev default in the code, so there is
#     nothing to override and nothing worth listing here. Grep the variable name
#     if you need to see the fallback.


# The running dev session's database. `make dev` starts a fresh one on this port and
# removes it when it stops, and hands its own processes the address itself — so this
# line is only for a command run by hand beside it, such as a fixture script. Keep it
# as it is. Test runs never read it: each starts a database of its own.
DATABASE_URL=postgres://anthers:anthers@localhost:5432/anthers

# `make dev` creates a local account from these in every session, so an empty
# database never costs you your login. Use the same username/email/password as your prod account.
# Leave blank to skip the bootstrap entirely.
#
# Every session starts from an empty database, so the account is created fresh each
# time from exactly what these lines say, as a real identity on the session's network.
# Signing in is the emailed code, read from the session's mail catcher.
DEV_ACCOUNT_USERNAME=
DEV_ACCOUNT_EMAIL=
# ⚠️ Anything granted by hand during a session is gone when it ends, so set ADMIN and
# CREATOR here or not at all. ADMIN=true also gives DEV_ACCOUNT_EMAIL a super-admin account
# in the admin app (http://localhost:3001), signed into with a code from the mail catcher.
DEV_ACCOUNT_ADMIN=false
DEV_ACCOUNT_CREATOR=true
