#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# Run what CI runs, before the push rather than after it.
#
# `main` requires CI to pass before a pull request merges, but that protection does not
# bind an administrator pushing straight to `main` or `release`, and a red commit that
# arrives that way simply stays there: an unformatted file landed in #168 and sat on `main`
# for three days, because `bun run lint` runs the FORMATTER too and nobody ran it locally.
# This gate is the one that covers every push, and it catches a red branch before a pull
# request spends CI's time finding out.
#
# `make verify` is deliberately the whole thing (typecheck, lint, migrate, unit tests, full
# Playwright) rather than a fast subset. A subset is what produced the problem: `bun test`
# alone is the unit suites, and `--project=gauntlet` skips the project the marketing specs
# live in, so a copy change sailed through both and failed in CI anyway.
#
# The one exception is a push whose every changed file is markdown, which runs
# `make verify-docs` — the checks that read markdown at all — instead. See `docs_only` below.
#
# The full suite runs in a detached worktree at the push's head rather than in this checkout,
# which frees the working copy during the hold and verifies the tree being pushed rather than
# whichever checkout the push was launched from — two backgrounded pushes collided with a
# `git checkout` mid-verify on 2026-09-19, and a hold that long is easily misread as a broken
# push. Each push's worktree lives at its own path (`.worktrees/pre-push-verify-<pid>`), so
# one push's verify can never be mistaken for another's leftover and two pushes run side by
# side without coordinating. The worktree is removed when the suite finishes; a warm second
# checkout would drift, and drift in the thing doing the verifying is its own class of bug.
# The docs-only fast path stays here — it is cheap and reads only markdown.
#
# Escape hatch: `git push --no-verify`. Use it for a WIP branch nobody builds on; don't use
# it for anything heading at `main`, which is the one case this catches.

remote="$1"

# Nothing to verify when every ref in this push is a deletion — there's no tree to
# check, and running the suite against the current checkout would test something
# the push isn't sending.
#
# 🚨 "No lines at all" is NOT the same as "only deletions", and conflating them turned
# this gate off. The loop below used to skip verification whenever `has_content` stayed 0,
# which is also what happens when git supplies nothing on stdin — so in any context where
# the ref list did not arrive, the hook exited 0 in silence and the push sailed through
# unverified. That is how a lint-red `main` accepted a push: the gate did not decline to
# fail, it declined to run, and the two look identical from outside. A gate that can skip
# itself quietly is worse than no gate, because it is trusted.
#
# 🚨 `docs_only` is the same hazard pointed the other way, so every doubt resolves to the
# full suite. It starts true and ANY ref that cannot be proved markdown-only clears it: a
# base commit that cannot be found, a diff that fails or comes back empty, a single path
# not ending in `.md`. Renames are listed as a deletion plus an addition (`--no-renames`),
# because otherwise `foo.ts → foo.md` reports only its new name and deleting code passes
# as a documentation change. `scripts/pre-push-hook.test.ts` drives this file for real.
zero="0000000000000000000000000000000000000000"
refs_seen=0
has_content=0
docs_only=1
push_head=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
	refs_seen=$((refs_seen + 1))
	[ -z "$local_sha" ] && continue
	[ "$local_sha" = "$zero" ] && continue
	has_content=1
	push_head="$local_sha"
	[ "$docs_only" -eq 1 ] || continue

	# A branch new to the remote has no remote tip, so it is measured from where it left
	# `main`. A stale `origin/main` only widens that diff, which can only cost the fast path.
	if [ "$remote_sha" = "$zero" ] || [ -z "$remote_sha" ]; then
		base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || base=""
	else
		base="$remote_sha"
	fi
	if [ -z "$base" ] || ! git cat-file -e "$base^{commit}" 2>/dev/null; then
		docs_only=0
		continue
	fi
	if ! changed=$(git diff --no-renames --name-only "$base" "$local_sha" 2>/dev/null) \
		|| [ -z "$changed" ] \
		|| printf '%s\n' "$changed" | grep -qv '\.md$'; then
		docs_only=0
	fi
done

# Skip only when git actually told us what it is pushing AND every ref was a deletion.
# If we were told nothing, verify: assuming there is nothing to check is the failure above.
if [ "$refs_seen" -gt 0 ] && [ "$has_content" -eq 0 ]; then
	exit 0
fi

target=verify
if [ "$refs_seen" -gt 0 ] && [ "$docs_only" -eq 1 ]; then
	target=verify-docs
	printf '\033[36m→ pre-push: only markdown changed, so running `make verify-docs` before pushing to %s\033[0m\n' "$remote"
fi

if [ "$target" = "verify-docs" ]; then
	if make "$target"; then
		printf '\033[32m✓ pre-push: %s passed\033[0m\n' "$target"
		exit 0
	fi

	printf '\n\033[31m✗ pre-push: %s FAILED — push aborted.\033[0m\n' "$target"
	printf '  Fix it, or bypass deliberately with: git push --no-verify\n'
	exit 1
fi

# `make verify` runs in a detached worktree at the push's head — see the header. Built on
# demand and removed when the suite finishes. Each push gets its own path keyed on this
# hook's PID, so two pushes from two sessions verify side by side rather than colliding on
# one shared worktree — a fixed path reads as stale leftover from outside, and removing the
# "leftover" of a live push is then both possible and invisible from the tree itself.
#
# Every step announces itself. The suite takes minutes of silence otherwise, and an agent
# driving the push from a non-interactive shell reads a silent 120 s as a hang and retries
# the push — which races the first one through the same gate. Saying "worktree / install /
# suite" as each starts tells the watcher the push is alive and which phase it is in.
printf '\033[36m→ pre-push: %s — running `make %s` before pushing\033[0m\n' "$(date +%H:%M:%S)" "$target"
printf '\033[36m→ pre-push: this is the whole suite (typecheck, lint, migrate, unit, full Playwright) — minutes, not seconds\033[0m\n'

worktree_dir=".worktrees/pre-push-verify-$$"
push_head_rev="HEAD"
if [ -n "$push_head" ]; then
	push_head_rev="$push_head"
else
	# No stdin from git is not a reason to test the empty tree; refuse rather than guess.
	printf '\n\033[31m✗ pre-push: git supplied no reference list, so there is no tree to verify — refusing to test this checkout instead of the push\033[0m\n'
	printf '  If this push is deliberate and the tree is right, bypass with: git push --no-verify\n'
	exit 1
fi

# A git hook inherits the pusher's GIT_DIR, which points at the repository that pushed rather
# than this checkout — any git command run under it would act there instead. Unset it before
# anything runs: the worktree path below is relative, so it must resolve against this checkout,
# not against whoever happened to push.
#
# 🚨 This scrub is not optional ceremony, and the hook's relative paths are the reason. A hook
# launched by a push from a LINKED WORKTREE receives GIT_DIR=<main>/.git/worktrees/<name> —
# an absolute path into ANOTHER checkout's index. Left set, two things break that look fine
# from the pushing terminal: the worktree add below resolves `.worktrees/…` against the
# pusher's tree (so a push from `.worktrees/push-guard` creates
# `.worktrees/push-guard/.worktrees/pre-push-verify-<pid>` and the suite verifies a nested
# leftover), and any bare `git` outside `git_clean` reports the pusher's state — including its
# uncommitted files — as this repository's. On 2026-09-22 that second failure let one
# session's half-finished account-suspension work fail the lint of a completely different
# branch's push. The hook itself never runs `git` before its first `git_clean` call, so GIT_DIR
# carries nothing it needs.
unset GIT_DIR

# GIT_DIR gone, resolve the checkout root and make relative paths honest. The worktree dir,
# the stub `make`'s `$PWD` and every `git worktree` command below all hang off the root, so
# they must not be at the mercy of a hook launched from a subdirectory or a sibling worktree.
repo_root=$(git rev-parse --show-toplevel) || {
	printf '\n\033[31m✗ pre-push: could not resolve the repository root to verify from\033[0m\n'
	exit 1
}
cd "$repo_root" || exit 1

# A git hook inherits the pusher's GIT_DIR, which points at the repository that pushed rather
# than this checkout — any git worktree command run under it would act there instead. Scrub
# the whole family; the same failure made the test suite rewrite the real repository.
# GIT_QUARANTINE_PATH goes with them: the worktree add below updates HEAD, which quarantine
# forbids, and nothing the hook does needs the push's not-yet-accepted objects anyway —
# origin/main is fetched fresh rather than read from the quarantine.
git_clean() {
	env -i PATH="$PATH" HOME="$HOME" git "$@"
}

# 🚨 A branch carrying a migration must still descend from origin/main. Two worktrees can each
# author the next migration number against the same parent; both verifies pass; the second push
# to land turns main's journal into a fork that drizzle-snapshots and the journal-order test
# only catch AFTER the merge — too late, because it now sits on main. The merge is not the
# moment to find out: production's migrator reads `when` from the journal and silently skips
# anything older than its newest applied entry, so a renumbered migration never lands. The
# right repair is to delete the migration files and regenerate against the merged schema
# (`bun run db:generate`), never to renumber. Check before the worktree is made, so a stale
# migration push fails fast and names the fix.
if [ -n "$push_head" ]; then
	# Cheap and idempotent; a failure to fetch must not block the push (offline dev, remote
	# down) — the suite that follows still catches an unmergeable journal, just later.
	git_clean fetch origin main >/dev/null 2>&1 || true
	if ! git_clean merge-base --is-ancestor origin/main "$push_head" 2>/dev/null; then
		# `--diff-filter=A` selects files the branch *added* under origin/main's view; an
		# amended file (same path, different content) is not a new migration slot, but a
		# branch that *deletes and regenerates* one is — both paths appear, so compare the
		# file itself rather than the file list.
		journal_change=$(git_clean diff --diff-filter=A --name-only origin/main "$push_head" -- packages/db/drizzle/ 2>/dev/null || true)
		if [ -n "$journal_change" ]; then
			printf '\n\033[31m✗ pre-push: another migration landed on origin/main since you forked — a journal push from here would fork main.\033[0m\n'
			printf '  Delete your migration files and bun run db:generate again against the merged schema.\n'
			printf '  Never renumber: production reads the journal%s `when` and silently skips anything older than its newest applied entry.\n' "'s"
			exit 1
		fi
	fi
fi

cleanup_worktree() {
	git_clean worktree remove --force "$worktree_dir" >/dev/null 2>&1 || true
	git_clean worktree prune >/dev/null 2>&1 || true
}
trap cleanup_worktree EXIT INT TERM

printf '\033[36m→ pre-push: %s — checking out the push'"'"'s head into %s\033[0m\n' "$(date +%H:%M:%S)" "$worktree_dir"
if ! git_clean worktree add --detach "$worktree_dir" "$push_head_rev"; then
	printf '\n\033[31m✗ pre-push: could not check out %s in %s\033[0m\n' "$push_head_rev" "$worktree_dir"
	exit 1
fi

# Install into the worktree; the shared Bun cache hardlinks the packages, so it is seconds
# rather than minutes (PR #287 measured ~0.14s).
printf '\033[36m→ pre-push: %s — installing dependencies (shared cache, fast)\033[0m\n' "$(date +%H:%M:%S)"
if ! (cd "$worktree_dir" && bun install >/dev/null); then
	printf '\n\033[31m✗ pre-push: bun install failed in %s\033[0m\n' "$worktree_dir"
	exit 1
fi

printf '\033[36m→ pre-push: %s — running the suite; streaming output below\033[0m\n\n' "$(date +%H:%M:%S)"
if (cd "$worktree_dir" && make "$target"); then
	printf '\033[32m✓ pre-push: %s passed\033[0m\n' "$target"
	exit 0
fi

printf '\n\033[31m✗ pre-push: %s FAILED — push aborted.\033[0m\n' "$target"
printf '  Fix it, or bypass deliberately with: git push --no-verify\n'
exit 1
