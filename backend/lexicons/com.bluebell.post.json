{
  "lexicon": 1,
  "id": "com.bluebell.post",
  "description": "A content post — devlog, video, audio, or written article.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["contentType", "createdAt"],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255,
            "description": "Post title."
          },
          "body": {
            "type": "string",
            "maxGraphemes": 100000,
            "description": "Plain text body content."
          },
          "bodyHtml": {
            "type": "string",
            "maxGraphemes": 200000,
            "description": "Rich text HTML body (from Tiptap editor)."
          },
          "contentType": {
            "type": "string",
            "knownValues": ["text", "video", "audio"],
            "description": "Primary content format."
          },
          "game": {
            "type": "ref",
            "ref": "com.bluebell.game",
            "description": "Associated game project (for devlogs)."
          },
          "videoBlob": {
            "type": "blob",
            "accept": ["video/mp4", "video/webm", "video/quicktime"],
            "maxSize": 5368709120,
            "description": "Original video file."
          },
          "audioBlob": {
            "type": "blob",
            "accept": ["audio/mpeg", "audio/mp4", "audio/ogg", "audio/wav", "audio/flac"],
            "maxSize": 536870912,
            "description": "Original audio file."
          },
          "thumbnail": {
            "type": "blob",
            "accept": ["image/jpeg", "image/png", "image/webp"],
            "maxSize": 10000000,
            "description": "Video/audio thumbnail image."
          },
          "durationSeconds": {
            "type": "integer",
            "minimum": 0,
            "description": "Media duration in seconds."
          },
          "visibility": {
            "type": "string",
            "knownValues": ["public", "subscribers_only", "gated"],
            "description": "Access control level."
          },
          "isPremium": {
            "type": "boolean",
            "description": "Premium content flag."
          },
          "isPublished": {
            "type": "boolean",
            "description": "Whether the post is publicly visible."
          },
          "estimatedReadMinutes": {
            "type": "integer",
            "minimum": 1,
            "description": "Estimated reading time for text posts."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Timestamp of initial creation."
          }
        }
      }
    }
  }
}
