{
  "lexicon": 1,
  "id": "com.bluebell.game",
  "description": "A game or interactive media project hosted on Bluebell.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["title", "slug", "createdAt"],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255,
            "description": "Project title."
          },
          "slug": {
            "type": "string",
            "maxLength": 255,
            "description": "URL-safe slug, unique per creator."
          },
          "description": {
            "type": "string",
            "maxGraphemes": 50000,
            "description": "Full project description (plain text or markdown)."
          },
          "shortDescription": {
            "type": "string",
            "maxLength": 300,
            "description": "Brief summary for cards and listings."
          },
          "mediaType": {
            "type": "string",
            "knownValues": ["game", "video", "audio", "text"],
            "description": "Primary media type of the project."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64
            },
            "maxLength": 20,
            "description": "Discoverable tags."
          },
          "pricingType": {
            "type": "string",
            "knownValues": ["free", "pwyw", "paid"],
            "description": "Pricing model."
          },
          "price": {
            "type": "string",
            "description": "Fixed price as decimal string (e.g. '9.99')."
          },
          "minPrice": {
            "type": "string",
            "description": "Minimum price for PWYW."
          },
          "suggestedPrice": {
            "type": "string",
            "description": "Suggested price for PWYW."
          },
          "coverImage": {
            "type": "blob",
            "accept": ["image/jpeg", "image/png", "image/webp"],
            "maxSize": 10000000,
            "description": "Cover/hero image."
          },
          "embedUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL for web-playable embed (HTML5/WebGL games)."
          },
          "websiteUrl": {
            "type": "string",
            "format": "uri",
            "description": "External project website."
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "description": "Source code URL (e.g. GitHub)."
          },
          "isPublished": {
            "type": "boolean",
            "description": "Whether the project is publicly visible."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Timestamp of initial creation."
          }
        }
      }
    }
  }
}
