{
  "lexicon": 1,
  "id": "com.bluebell.rating",
  "description": "A user rating for a game project (1-5 stars).",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["subject", "score", "createdAt"],
        "properties": {
          "subject": {
            "type": "ref",
            "ref": "com.bluebell.game",
            "description": "The game being rated."
          },
          "score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Rating score (1-5)."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Timestamp of the rating."
          }
        }
      }
    }
  }
}
