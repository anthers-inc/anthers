{
  "lexicon": 1,
  "id": "com.bluebell.follow",
  "description": "A follow relationship — user follows a creator.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["subject", "createdAt"],
        "properties": {
          "subject": {
            "type": "string",
            "format": "did",
            "description": "DID of the creator being followed."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Timestamp when the follow was created."
          }
        }
      }
    }
  }
}
